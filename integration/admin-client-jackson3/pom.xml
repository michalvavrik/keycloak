<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>keycloak-integration-parent</artifactId>
        <groupId>org.keycloak</groupId>
        <version>999.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>keycloak-admin-client-jackson3</artifactId>
    <name>Keycloak Admin REST Client (Jackson 3)</name>
    <description>Jackson 3 provider for the Keycloak Admin REST Client. Use this instead of org.keycloak:keycloak-admin-client when your application uses Jackson 3</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <version.tools.jackson>3.1.7</version.tools.jackson>
        <version.resteasy.jackson.provider>1.0.0.Final</version.resteasy.jackson.provider>
        <version.invoker.plugin>3.9.1</version.invoker.plugin>
        <!-- default for the consumer integration test below, overridden by -DskipTests -->
        <skipTests>false</skipTests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-admin-client-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${version.tools.jackson}</version>
        </dependency>
        <dependency>
            <groupId>dev.resteasy.providers</groupId>
            <artifactId>resteasy-jackson-provider</artifactId>
            <version>${version.resteasy.jackson.provider}</version>
            <!--
              The provider is built against RESTEasy 7, the admin client runs on the RESTEasy version used by the rest of
              Keycloak. Inside this build the parent POM forces every RESTEasy artifact to that version, consumers of the
              published artifact do not inherit that dependency management and would end up with RESTEasy 7 core jars
              next to the RESTEasy client jars of resteasy.version. Excluding them here makes consumers resolve a single
              RESTEasy version; src/it/consumer verifies that.
            -->
            <exclusions>
                <exclusion>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-client</artifactId>
            <version>${resteasy.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!--
                  Builds src/it/consumer as a standalone project against the artifact of this module. Only a project
                  outside of this build resolves the dependency tree the way consumers of the published artifact do,
                  as the dependency management of the parent POM is not applied to them.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>${version.invoker.plugin}</version>
                <configuration>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <streamLogs>true</streamLogs>
                    <skipInstallation>${skipTests}</skipInstallation>
                    <skipInvocation>${skipTests}</skipInvocation>
                    <filterProperties>
                        <resteasy.version>${resteasy.version}</resteasy.version>
                        <maven.compiler.release>${maven.compiler.release}</maven.compiler.release>
                        <maven-compiler-plugin.version>${maven-compiler-plugin.version}</maven-compiler-plugin.version>
                        <version.surefire.plugin>${version.surefire.plugin}</version.surefire.plugin>
                    </filterProperties>
                </configuration>
                <executions>
                    <execution>
                        <id>consumer-integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
